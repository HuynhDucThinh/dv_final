# VietCar AI — Environment Config
# Copy từ .env.example — KHÔNG commit file này lên git

# ==================================================
# 1. URLs
# ==================================================
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
RUNTIME_PROFILE=local
CHAT_STORAGE_MODE=browser
NEXT_PUBLIC_CHAT_STORAGE_MODE=browser

# ==================================================
# 2. API Keys
# ==================================================
HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# --- Module Phân tích Dữ liệu ---
GROQ_API_KEY=

ENABLE_GOOGLE_FALLBACK=false
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ==================================================
# 3. Inference
# ==================================================
INFERENCE_STRATEGY=remote_only
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=4096
LLM_TIMEOUT=120

# ==================================================
# 4. CORS
# ==================================================
CORS_ORIGINS=http://localhost:3000
